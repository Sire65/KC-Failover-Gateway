{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kc-failover-gateway",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_CONFIG_ID"
    }
  ]
}
